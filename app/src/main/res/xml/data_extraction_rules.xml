<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bioterre_secondary_security.xml" />
        <exclude domain="sharedpref" path="bioterre_biometric_auth.xml" />
        <exclude domain="sharedpref" path="bioterre_auth_draft.xml" />
        <exclude domain="sharedpref" path="bioterre_device_lock.xml" />
        <exclude domain="file" path="offline_svt" />
        <exclude domain="file" path="exports" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bioterre_secondary_security.xml" />
        <exclude domain="sharedpref" path="bioterre_biometric_auth.xml" />
        <exclude domain="sharedpref" path="bioterre_auth_draft.xml" />
        <exclude domain="sharedpref" path="bioterre_device_lock.xml" />
        <exclude domain="file" path="offline_svt" />
        <exclude domain="file" path="exports" />
    </device-transfer>
</data-extraction-rules>
